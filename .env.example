# Copy to .env.local for local dev (Vite).

# Dedicated duel server (optional)
# VITE_WS_URL=ws://127.0.0.1:8787

# Feature flags
# VITE_ENABLE_P2P=false
# VITE_ENABLE_LOCAL_FFA=false

# Сборка: web (дефолт, обязательный облачный логин) | steam | electron | local
# VITE_PLATFORM=web

# Supabase cloud progress (optional — without these, game stays local-only)
# Create a project at https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# After creating the project:
# 1) Run supabase/schema.sql in SQL Editor
# 2) Auth → Providers → enable Google and Discord
# 3) Auth → URL Configuration:
#    - Site URL: your main app URL (e.g. http://138.201.50.89:8080)
#    - Redirect URLs (one per line), include wildcards:
#        http://127.0.0.1:5199/**
#        http://localhost:5199/**
#        http://138.201.50.89:8080/**
#    Email magic-link / OTP redirect uses emailRedirectTo from the client;
#    if that origin is NOT allowlisted, Supabase falls back to Site URL
#    (often http://localhost:3000 — wrong for preview).
# 4) In Google/Discord consoles, set redirect to:
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
