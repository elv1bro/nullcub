[node name="Legend" type="RichTextLabel" parent="Root/HelpPanel"]
custom_minimum_size = Vector2(590, 0)
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.86, 0.82, 0.76, 1)
theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "[color=#fff0d0]●[/color]  свободный якорь
[color=#74f25f]◯[/color]  тащишь деталь — сюда встанет
[color=#ffa040]○[/color]  занято — встанет на замену
[color=#ff5a45]✖[/color]  не влезает по энергии
[color=#ffd050]◯[/color] / [color=#5accff]◯[/color]  тяга ЛКМ / ПКМ (Q, клик по детали)
[color=#8cd9ff]●[/color]  Шарниры, Материал: выбери на полке, кликни по детали
[color=#ff6fb0]●[/color]  Покраска: баллончик, трафареты, наклейки, фото; R — повернуть стенд
ПКМ по детали — открутить вместе с тем, что на ней
Клик по детали на кукле — выбрать: справа её данные, D — дубликат, M — зеркально на другую сторону, Del — удалить
◎ — центр массы; при протяжке пунктиром — куда он сместится с новой деталью"
