## Каталог режимов — 100+ карточек руками (docs/plan-demo/MODES_100.md, 08.10; автор: «хочу сделать более 100+ режимов игр
## разных»). Карточка: id, имя, основа, модификаторы (Mutators.CATALOG), описание, теги, карта, числа. Имена и описания — русские
## строки для tr() (перевод — locale/en.json). Добавить режим = одна строка в _build(). Порядок в списке — порядок здесь.
## Теги: бой, купол, безумие, гравитация, спорт, гонка, бомба, стычка, pve, вдвоём, боты, быстро, долго, предметы, суставы.
class_name ModeCatalog
extends RefCounted

static var _all: Array = []
static var _by_id: Dictionary = {}


static func all() -> Array:
	if _all.is_empty():
		_build()
	return _all


static func by_id(id: String) -> ModeDef:
	if _all.is_empty():
		_build()
	return _by_id.get(id, null)


static func count() -> int:
	return all().size()


## Все теги в порядке первого появления.
static func tags() -> Array:
	var out: Array = []
	for d in all():
		for t in (d as ModeDef).tags:
			if not out.has(t):
				out.append(t)
	return out


static func by_tag(tag: String) -> Array:
	return all().filter(func(d: ModeDef) -> bool: return d.tags.has(tag))


static func random_def(rng: RandomNumberGenerator = null) -> ModeDef:
	var a := all()
	if rng == null:
		return a[randi() % a.size()]
	return a[rng.randi() % a.size()]


## «Режим дня»: один и тот же для всех в этот день (сид — день от эпохи).
static func daily() -> ModeDef:
	var rng := RandomNumberGenerator.new()
	rng.seed = int(Time.get_unix_time_from_system() / 86400.0)
	return random_def(rng)


static func _add(id: String, name: String, base: String, muts: Array, desc: String, tags_: Array, map := "", params := {}) -> void:
	var d := ModeDef.make(id, name, base, muts, desc, tags_, map, params)
	if _by_id.has(id):
		push_error("ModeCatalog: повтор id %s" % id)
		return
	_all.append(d)
	_by_id[id] = d


