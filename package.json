{
  "name": "ragdoll-faces",
  "version": "0.1.0",
  "private": true,
  "description": "Ragdoll Masters fork — мимика с вебки, HP, расширяемый контент",
  "license": "WTFPL",
  "author": "One Does <onedoes.inc@gmail.com> (https://onedoes.github.io/)",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 5199",
    "preview": "vite preview --host 127.0.0.1 --port 5199",
    "test": "vitest run",
    "test:duel": "vitest run src/server/duelStability.test.ts",
    "smoke:duel": "node --import tsx/esm scripts/duel-smoke.mjs",
    "verify:browser": "node scripts/verify-app.mjs",
    "verify:browser:fast": "node scripts/verify-app.mjs --skip-duel",
    "verify:screenshots": "node scripts/capture-battle-screenshots.mjs",
    "verify:game": "yarn test && yarn smoke:duel && yarn verify:browser",
    "verify": "yarn verify:game",
    "verify:ai": "yarn test && yarn smoke:duel && yarn verify:browser:fast",
    "benchmark:ai": "vitest run src/battle/aiBenchmark.test.ts",
    "benchmark:ai:chrome": "node scripts/run-ai-benchmark-chrome.mjs",
    "server": "tsx --tsconfig tsconfig.server.json src/server/main.ts",
    "electron:hub": "electron electron/main.mjs --mode=hub",
    "electron:client": "electron electron/main.mjs --mode=client"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@xstate/react": "^3.2.1",
    "color-string": "^1.9.1",
    "debug": "^4.3.4",
    "defaults": "^3.0.0",
    "eases": "^1.0.8",
    "matter-js": "^0.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use": "^17.4.0",
    "trystero": "^0.25.2",
    "ws": "^8.18.0",
    "xstate": "^4.37.1"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.0",
    "@tsconfig/vite-react": "^3.0.0",
    "@types/color-string": "^1",
    "@types/debug": "^4.1.7",
    "@types/eases": "^1",
    "@types/matter-js": "^0.20.0",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "@types/ws": "^8.5.13",
    "@unocss/preset-web-fonts": "^0.65.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@xstate/inspect": "^0.8.0",
    "electron": "^43.0.0",
    "puppeteer": "^25.3.0",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.4",
    "unocss": "^0.65.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "packageManager": "yarn@4.15.0"
}
